<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Student Registration Form</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f5dada;
        }
        .form-container {
            background: #f8e1e1;
            padding: 30px;
            border-radius: 10px;
            max-width: 750px;
            margin: 30px auto;
        }
        h2 {
            text-align: center;
            margin-bottom: 25px;
            font-weight: bold;
        }
        input:valid, select:valid, textarea:valid {
            border-color: green !important;
        }
        input:invalid, select:invalid, textarea:invalid {
            border-color: red !important;
        }
    </style>
</head>
<body>
<div class="container">
    <div class="form-container shadow">
        <h2>Student Registration Form</h2>
        <form>
            <div class="row mb-3">
                <label class="col-md-4 col-form-label">Roll No:</label>
                <div class="col-md-8">
                    <input type="text" class="form-control" required>
                </div>
            </div>
            <div class="row mb-3">
                <label class="col-md-4 col-form-label">Student Name:</label>
                <div class="col-md-4">
                    <input type="text" class="form-control" placeholder="First Name" required pattern="[A-Za-z]{2,}">
                </div>
                <div class="col-md-4">
                    <input type="text" class="form-control" placeholder="Last Name" required pattern="[A-Za-z]{1,}">
                </div>
            </div>
            <div class="row mb-3">
                <label class="col-md-4 col-form-label">Father's Name:</label>
                <div class="col-md-8">
                    <input type="text" class="form-control" required>
                </div>
            </div>
            <div class="row mb-3">
                <label class="col-md-4 col-form-label">Date of Birth:</label>
                <div class="col-md-2">
                    <input type="number" class="form-control" placeholder="DD" min="1" max="31" required>
                </div>
                <div class="col-md-2">
                    <input type="number" class="form-control" placeholder="MM" min="1" max="12" required>
                </div>
                <div class="col-md-4">
                    <input type="number" class="form-control" placeholder="YYYY" min="1990" max="2025" required>
                </div>
            </div>
            <div class="row mb-3">
                <label class="col-md-4 col-form-label">Mobile No:</label>
                <div class="col-md-2">
                    <input type="text" class="form-control" value="+91" readonly>
                </div>
                <div class="col-md-6">
                    <input type="tel" class="form-control" pattern="[0-9]{10}" placeholder="10 digit number" required>
                </div>
            </div>
            <div class="row mb-3">
                <label class="col-md-4 col-form-label">Email ID:</label>
                <div class="col-md-8">
                    <input type="email" class="form-control" required>
                </div>
            </div>
            <div class="row mb-3">
                <label class="col-md-4 col-form-label">Password:</label>
                <div class="col-md-8">
                    <input type="password" class="form-control" required pattern=".{6,}" placeholder="Min 6 characters">
                </div>
            </div>
            <div class="row mb-3">
                <label class="col-md-4 col-form-label">Gender:</label>
                <div class="col-md-8">
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="gender" required>
                        <label class="form-check-label">Male</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="gender">
                        <label class="form-check-label">Female</label>
                    </div>
                </div>
            </div>
            <div class="row mb-3">
                <label class="col-md-4 col-form-label">Department:</label>
                <div class="col-md-8">
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox"> CSE
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox"> IT
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox"> ECE
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox"> Civil
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox"> Mech
                    </div>
                </div>
            </div>
            <div class="row mb-3">
                <label class="col-md-4 col-form-label">Course:</label>
                <div class="col-md-8">
                    <select class="form-select" required>
                        <option value="">Select Course</option>
                        <option>B.Tech</option>
                        <option>B.Sc</option>
                        <option>BCA</option>
                        <option>MCA</option>
                    </select>
                </div>
            </div>
            <div class="row mb-3">
                <label class="col-md-4 col-form-label">Student Photo:</label>
                <div class="col-md-8">
                    <input type="file" class="form-control" required>
                </div>
            </div>
            <div class="row mb-3">
                <label class="col-md-4 col-form-label">City:</label>
                <div class="col-md-8">
                    <input type="text" class="form-control" required>
                </div>
            </div>

            <!-- Address -->
            <div class="row mb-3">
                <label class="col-md-4 col-form-label">Address:</label>
                <div class="col-md-8">
                    <textarea class="form-control" rows="3" required></textarea>
                </div>
            </div>
            <div class="text-center">
                <button type="submit" class="btn btn-dark px-4">Register</button>
            </div>

        </form>
    </div>
</div>

</body>
</html>
